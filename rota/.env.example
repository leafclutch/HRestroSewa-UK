# HRestroSewa Rota PWA — environment template. Copy to `rota/.env.local` for dev.
# Real values never go in git (the root .gitignore covers every .env.* file).

# Where the MAIN app is served. The rota app is a front end only: it signs in and
# reads/writes the rota through the main app's /api/rota. Baked in at BUILD time
# (NEXT_PUBLIC_*), so changing it needs a rebuild.
#   dev:  http://localhost:3000
#   prod: https://<main app domain>
NEXT_PUBLIC_MAIN_API_URL=http://localhost:3000

# On the MAIN app (its own env, not this file), allow this app's origin:
#   ROTA_APP_ORIGINS=http://localhost:3001,https://rota.<domain>
